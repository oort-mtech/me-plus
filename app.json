{
  "expo": {
    "name": "me-plus",
    "slug": "me-plus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meplus.app",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs access to camera to scan food plates and track your meals."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.meplus.app",
      "permissions": [
        "CAMERA"
      ],
      "jsEngine": "hermes"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow me-plus to access your camera to scan food plates."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "me-plus"
      }
    }
  }
}
